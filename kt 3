import csv

def get_books(filename):
    """Задание 1: читает CSV и возвращает список списков с преобразованными типами."""
    with open(filename, 'r', encoding='cp1251') as f:
        reader = csv.reader(f, delimiter='|')
        # Пропускаем заголовок
        header = next(reader)
        # Преобразуем данные: isbn, title, author, quantity(int), price(float)
        return [header] + list(
            map(lambda row: [
                row[0],                     # isbn
                row[1],                     # title
                row[2],                     # author
                int(row[3]),                # quantity
                float(row[4])               # price
            ], reader)
        )

def filtered_books(books, substring):
    """Задание 2: фильтрует по substring в title, объединяя title и author."""
    header = books[0]
    # Новый заголовок: isbn, 'title, author', quantity, price
    new_header = [header[0], 'title, author', header[3], header[4]]
    
    data = books[1:]
    filtered = list(
        filter(lambda row: substring.lower() in row[1].lower(), data)
    )
    
    return [new_header] + list(
        map(lambda row: [
            row[0],                     # isbn
            f"{row[1]}, {row[2]}",      # объединённые title и author
            row[3],                     # quantity
            row[4]                      # price
        ], filtered)
    )

def calculate_total_values(filtered_books_list):
    """Задание 3: возвращает список кортежей (isbn, quantity * price)."""
    # Пропускаем заголовок
    data = filtered_books_list[1:]
    return list(
        map(lambda row: (row[0], row[2] * row[3]), data)
    )

def show_result(msg):
  print(msg)


books = get_books("books.csv")
show_result('Number 1')
for row in books:
  show_result(row)
    
filtered = filtered_books(books, "python")
show_result('Number 2')
for row in filtered:
  show_result(row)
    
totals = calculate_total_values(filtered)
show_result('Number 3')
for item in totals:
  show_result(item)
